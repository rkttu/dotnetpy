<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<!-- NuGet Package Metadata -->
	<PropertyGroup>
		<PackageId>DotNetPy</PackageId>
		<Description>A lightweight .NET library for seamless Python interoperability with zero boilerplate, Native AOT support, and automatic Python discovery. Execute Python code, evaluate expressions, and exchange data between .NET and Python with minimal learning curve.</Description>
		<PackageTags>python;interop;csharp;dotnet;scripting;python-integration;native-aot;aot-friendly;python-executor</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<!-- Source Link for debugging -->
	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.102" PrivateAssets="All" />
	</ItemGroup>

	<!-- Reference Analyzers project (build dependency only, not runtime) -->
	<ItemGroup>
		<ProjectReference Include="..\DotNetPy.Analyzers\DotNetPy.Analyzers.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
			<UndefineProperties>TargetFramework</UndefineProperties>
		</ProjectReference>
	</ItemGroup>

	<!-- Pack analyzer DLL into the NuGet package -->
	<ItemGroup>
		<None Include="..\DotNetPy.Analyzers\bin\$(Configuration)\netstandard2.0\DotNetPy.Analyzers.dll" Pack="true" PackagePath="analyzers\dotnet\cs" Visible="false" Condition="Exists('..\DotNetPy.Analyzers\bin\$(Configuration)\netstandard2.0\DotNetPy.Analyzers.dll')" />
	</ItemGroup>

</Project>
